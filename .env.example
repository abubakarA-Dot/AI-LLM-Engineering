# Copy this file to .env and fill in real values. .env itself is gitignored -- never commit it.

# Ollama (free-first path -- default)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Paid APIs (fill in only once you upgrade -- see the plan's "Free-First Path")
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database (pgvector-enabled Postgres container, see Week 0 setup)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=ai_llm_project
